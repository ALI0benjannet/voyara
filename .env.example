# ==========================================================
# Secrets pour docker-compose (copier vers `.env` et remplir)
# En dev local (sans Docker), chaque service a son propre
# fichier services/<nom>/.env — voir services/*/.env.example
# ==========================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Doit être identique dans tous les services
JWT_SECRET_KEY=change-me-long-random-string
INTERNAL_API_KEY=change-me-other-random-string

# SMTP (notification-service)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=Voyara
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

FRONTEND_URL=http://localhost:5173

# Compte admin initial
FIRST_ADMIN_EMAIL=admin@voyara.com
FIRST_ADMIN_PASSWORD=ChangeMe@1234

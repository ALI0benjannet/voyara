POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voyara_booking

JWT_SECRET_KEY=change-me
INTERNAL_API_KEY=dev-internal-key-change-me

CATALOG_SERVICE_URL=http://localhost:8002
AUTO_CREATE_TABLES=True
AUTH_SERVICE_URL=http://localhost:8001
NOTIFICATION_SERVICE_URL=http://localhost:8006

# Expiration des réservations non payées : au-delà de ce délai, une réservation
# `pending` est annulée et ses places rendues au catalogue (180 min = 3 h).
BOOKING_EXPIRY_MINUTES=180
BOOKING_EXPIRY_SWEEP_SECONDS=300
BOOKING_EXPIRY_ENABLED=True

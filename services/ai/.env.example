POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
# Conteneur dédié `postgres-ai` (pgvector/pgvector:pg16), distinct du Postgres principal (5434)
POSTGRES_PORT=5435
POSTGRES_DB=voyara_ai

JWT_SECRET_KEY=change-me
INTERNAL_API_KEY=dev-internal-key-change-me

# Sources de données ouvertes (sans clé)
OVERPASS_URL=https://overpass-api.de/api/interpreter
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
METEO_CACHE_HEURES=6

# Création de l'extension vector et des tables au démarrage (dev)
AUTO_CREATE_TABLES=True

# Catalogue (routes /internal/* de l'étape 2-bis) — 127.0.0.1 et non localhost (IPv6 sous Windows)
CATALOG_SERVICE_URL=http://127.0.0.1:8002
CATALOG_TIMEOUT_S=5

# Couche LLM hybride (étape 3)
# claude | ollama | auto (Claude, puis Ollama si clé absente, panne ou délai dépassé)
LLM_PROVIDER=auto
# À remplir par toi seulement, jamais dans le code ni un rapport. Vide = Ollama en mode auto.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
CLAUDE_TIMEOUT_S=60
CLAUDE_MAX_RETRIES=1
CLAUDE_FALLBACKS=True
# Ollama local : docker compose --profile ollama up -d ollama ; puis ollama pull qwen2.5:3b (ou qwen2.5:7b si >= 16 Go de RAM)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_S=180
